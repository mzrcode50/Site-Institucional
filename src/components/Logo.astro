---
// Logo F: linha contínua M → Z. "id" evita conflito de gradiente quando houver mais de um na página.
const { id = 'lg', variant = 'dark' } = Astro.props;
const from = variant === 'dark' ? '#FBBF24' : '#B45309';
const to = variant === 'dark' ? '#2DD4BF' : '#0F766E';
---
<svg viewBox="0 0 78 48" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={id} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color={from} />
      <stop offset="1" stop-color={to} />
    </linearGradient>
  </defs>
  <path d="M5 38 V10 L17 26 L29 10 H45 L29 38 H53 V10 H63 C72 10 72 26 63 26 H53 L73 38" fill="none" stroke={`url(#${id})`} stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
